# Copy to .env, then replace the development password placeholder.
POSTGRES_USER=dungeon_crawl
POSTGRES_PASSWORD=replace-this-local-development-password
POSTGRES_DB=dungeon_crawl_dev
DATABASE_URL=postgresql://dungeon_crawl:replace-this-local-development-password@localhost:5432/dungeon_crawl_dev

CLIENT_ORIGIN=http://localhost:5173
VITE_MULTIPLAYER_URL=http://localhost:3001
PORT=3001
HOST=127.0.0.1

# Optional PostgreSQL integration tests (use a disposable database).
# DATABASE_TEST_URL=postgresql://dungeon_crawl:replace-this-local-development-password@localhost:5432/dungeon_crawl_test
